# Backend
IVQC_APP_NAME=industrial-vision-qc-backend
IVQC_ENVIRONMENT=development
IVQC_LOG_LEVEL=INFO
IVQC_DATABASE_URL=postgresql+asyncpg://vision_qc:vision_qc@127.0.0.1:5432/vision_qc
IVQC_INFERENCE_SERVICE_URL=http://127.0.0.1:8100
IVQC_INFERENCE_TIMEOUT_SECONDS=30
IVQC_MAX_UPLOAD_BYTES=10485760

# Inference service
IVQC_WEIGHTS=../model-training/runs/neu-det-yolov8s-baseline-2/weights/best.pt
IVQC_MODEL_VERSION=phase1-baseline
IVQC_DEVICE=
