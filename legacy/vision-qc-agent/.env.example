# Runtime
APP_ENV=development
APP_NAME=vision-qc-agent
LOG_LEVEL=INFO
API_CORS_ORIGINS=["http://localhost:3000"]
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Persistence and queue (Docker Compose defaults)
DATABASE_URL=postgresql+asyncpg://vision_qc:vision_qc@postgres:5432/vision_qc
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# Provider mode: mock or real. CI must keep mock.
AI_MODE=mock
MOCK_VISION_MODEL=mock-vision-v1
MOCK_REASONING_MODEL=mock-reasoning-v1

# Alibaba Cloud Bailian compatible endpoint
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-vl-plus
BAILIAN_TIMEOUT_SECONDS=30
BAILIAN_MAX_RETRIES=2

# DeepSeek compatible endpoint
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=2

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_OPERATOR_ROLE=supervisor
